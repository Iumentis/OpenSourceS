-- [[ SAFE CANVAS UPDATE ]] --
local function updateRemoteCanvas()
    if not LogList or not UIListLayout then return end
    
    -- Use pcall to safely get content size
    local success, contentX, contentY = pcall(function()
        local size = UIListLayout.AbsoluteContentSize
        return size.X, size.Y
    end)
    
    if success then
        LogList.CanvasSize = UDim2.fromOffset(contentX or 0, contentY or 0)
    else
        -- Fallback: calculate manually
        local totalHeight = 0
        for _, child in _ipairs(LogList:GetChildren()) do
            if child:IsA("Frame") and child.Visible then
                totalHeight = totalHeight + child.Size.Y.Offset + 5
            end
        end
        LogList.CanvasSize = UDim2.fromOffset(0, math_max(totalHeight, 232))
    end
end

local function updateFunctionCanvas()
    if not ScrollingFrame or not UIGridLayout then return end
    
    local success, contentX, contentY = pcall(function()
        local size = UIGridLayout.AbsoluteContentSize
        return size.X, size.Y
    end)
    
    if success then
        ScrollingFrame.CanvasSize = UDim2.fromOffset(contentX or 0, contentY or 0)
    end
end

-- [[ REMOTE LOGGING ]] --
local function getRemoteInfo(remote)
    if not remoteClassCache[remote] then
        if remote:IsA("RemoteEvent") then
            remoteClassCache[remote] = "event"
        elseif remote:IsA("RemoteFunction") then
            remoteClassCache[remote] = "function"
        elseif remote:IsA("UnreliableRemoteEvent") then
            remoteClassCache[remote] = "unreliable"
        else
            remoteClassCache[remote] = "unknown"
        end
    end
    
    if not remoteIdCache[remote] then
        remoteIdCache[remote] = game.GetDebugId(remote)
    end
    
    return remoteClassCache[remote], remoteIdCache[remote]
end

local function processLogQueue()
    if #logQueue == 0 then 
        uiUpdatePending = false
        return 
    end
    
    local batchSize = math_min(5, #logQueue)
    for i = 1, batchSize do
        local data = logQueue[i]
        if data then
            createRemoteLog(data)
        end
    end
    
    for i = 1, batchSize do
        table_remove(logQueue, 1)
    end
    
    if #logQueue > 0 then
        task_defer(processLogQueue)
    else
        uiUpdatePending = false
        updateRemoteCanvas()
    end
end

local function queueRemoteLog(data)
    if #logQueue > configs.maxRemotes * 2 then
        return
    end
    
    table_insert(logQueue, data)
    
    if not uiUpdatePending then
        uiUpdatePending = true
        task_defer(processLogQueue)
    end
end

