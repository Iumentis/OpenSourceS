local function createInstance(className, properties, children)
    local obj = Instance_new(className)
    for k, v in _pairs(properties or {}) do
        obj[k] = v
    end
    if children then
        for _, child in _ipairs(children) do
            child.Parent = obj
        end
    end
    return obj
end

-- [[ OPTIMIZED TABLE UTILITIES ]] --
local function shallowClone(t)
    if _type(t) ~= "table" then return t end
    local result = {}
    for k, v in _pairs(t) do
        if _typeof(v) == "Instance" then
            result[k] = cloneref(v)
        else
            result[k] = v
        end
    end
    return result
end

local function safeDeepClone(t, depth)
    depth = depth or 0
    if depth > 10 then return t end
    if _type(t) ~= "table" then return t end
    
    local result = {}
    for k, v in _pairs(t) do
        if _type(v) == "table" then
            result[k] = safeDeepClone(v, depth + 1)
        elseif _typeof(v) == "Instance" then
            result[k] = cloneref(v)
        else
            result[k] = v
        end
    end
    return result
end

-- [[ OPTIMIZED SERIALIZATION ]] --
local function formatString(str)
    if #str > configs.maxStringSize then
        str = string_sub(str, 1, configs.maxStringSize)
    end
    
    local result = string_gsub(str, "\\", "\\\\")
    result = string_gsub(result, "\"", "\\\"")
    result = string_gsub(result, "\n", "\\n")
    result = string_gsub(result, "\t", "\\t")
    result = string_gsub(result, "\r", "\\r")
    
    return "\"" .. result .. "\""
end

local function serializeValue(v, depth)
    depth = depth or 0
    if depth > 5 then return "..." end
    
    local t = _type(v)
    
    if t == "number" then
        if v ~= v then return "0/0" end
        if v == math_huge then return "math.huge" end
        if v == -math_huge then return "-math.huge" end
        return _tostring(v)
    elseif t == "string" then
        return formatString(v)
    elseif t == "boolean" then
        return _tostring(v)
    elseif t == "nil" then
        return "nil"
    elseif _typeof(v) == "Instance" then
        return "game:GetService(\"" .. v.ClassName .. "\")"
    elseif t == "table" then
        return serializeTable(v, depth + 1)
    else
        return _tostring(v)
    end
end

local function serializeTable(t, depth)
    if depth > configs.maxTableSize then
        return "{} --[[truncated]]"
    end
    
    local result = "{"
    local count = 0
    
    for k, v in _pairs(t) do
        count = count + 1
        if count > configs.maxTableSize then
            result = result .. " ... --[[truncated]]"
            break
        end
        
        local keyStr
        if _type(k) == "string" and k:match("^[%a_][%w_]*$") then
            keyStr = k
        else
            keyStr = "[" .. serializeValue(k, depth + 1) .. "]"
        end
        
        result = result .. keyStr .. "=" .. serializeValue(v, depth + 1) .. ","
    end
    
    return result .. "}"
end

