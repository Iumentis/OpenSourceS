-- [[ BYTENET DECODE ]] --
local function getByteNetModules()
    if packetCache and packetIDCache and packetNameCache then
        return packetCache, packetIDCache, packetNameCache
    end
    
    local success, Packets = pcall(require, game:GetService("ReplicatedStorage").Modules.Packets)
    if not success then return nil, nil, nil end
    
    local success2, packetIDs = pcall(require, game:GetService("ReplicatedStorage").Modules.ByteNet.packets.packetIDs)
    if not success2 then return nil, nil, nil end
    
    local packetNames = {}
    for name, obj in _pairs(Packets) do
        if _type(obj) == "table" and obj.reader then
            packetNames[obj] = name
        end
    end
    
    packetCache = Packets
    packetIDCache = packetIDs
    packetNameCache = packetNames
    
    return Packets, packetIDs, packetNames
end

local function decodeByteNet()
    if not selected then
        TextLabel.Text = "No remote selected"
        return
    end
    
    local remote = selected.Remote
    if not remote or (remote.Name ~= "ByteNetReliable" and remote.Name ~= "ByteNetUnreliable") then
        TextLabel.Text = "Not a ByteNet remote"
        return
    end
    
    local args = selected.Args
    if not args or #args == 0 then
        TextLabel.Text = "No arguments"
        return
    end
    
    local bufferArg = args[1]
    if _type(bufferArg) ~= "buffer" then
        TextLabel.Text = "First argument is not a buffer"
        return
    end
    
    local Packets, packetIDs, packetNames = getByteNetModules()
    if not Packets then
        TextLabel.Text = "ByteNet modules not found"
        return
    end
    
    local function decodeBuffer(buf)
        if _type(buf) ~= "buffer" then return nil, "Not a buffer" end
        
        local len = buffer.len(buf)
        if len < 2 then return nil, "Buffer too short" end
        
        local flag = buffer.readu8(buf, 0)
        local id = buffer.readu8(buf, 1)
        
        local packetObj = packetIDs[id]
        if not packetObj then return nil, "Unknown packet ID: " .. id end
        
        local name = packetNames[packetObj] or "Unnamed"
        local reader = packetObj.reader
        if not reader then return nil, "No reader for " .. name end
        
        local success, data = pcall(reader, buf, 2)
        if not success then return nil, "Reader error: " .. _tostring(data) end
        
        return {
            name = name,
            id = id,
            flag = flag,
            data = data,
            size = len
        }
    end
    
    local decoded, err = decodeBuffer(bufferArg)
    if not decoded then
        TextLabel.Text = "Decode failed: " .. err
        return
    end
    
    local display = string_format("--Decoded ByteNet Packet\nPacket: %s (ID: %d, Flag: %d, Size: %d bytes)\nData:\n",
        decoded.name, decoded.id, decoded.flag, decoded.size)
    
    display = display .. serializeTable(decoded.data, 0)
    display = display .. "\n--End of decoded data"
    
    codebox:setRaw(display)
    TextLabel.Text = "Decoded!"
end

-- [[ SETUP ALL BUTTONS ]] --
local function setupButtons()
    createButton("Copy Code", "Copy code to clipboard", function()
        setclipboard(codebox:getString())
        TextLabel.Text = "Copied!"
    end)
    
    createButton("Run Code", "Execute code", function()
        if selected then
            local remote = selected.Remote
            if remote then
                pcall(function()
                    local args = selected.Args or {}
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer(_unpack(args))
                    elseif remote:IsA("RemoteFunction") then
                        remote:InvokeServer(_unpack(args))
                    end
                    TextLabel.Text = "Executed!"
                end)
            end
        end
    end)
    
    createButton("Clr Logs", "Clear logs", function()
        for _, v in _ipairs(logs) do
            if v.Log and v.Log.Parent then
                v.Log:Destroy()
            end
        end
        table_clear(logs)
        selected = nil
        codebox:setRaw("")
        TextLabel.Text = "Cleared!"
    end)
    
    createButton("Exclude", "Exclude remote", function()
        if selected then
            blacklist[selected.Remote] = true
            TextLabel.Text = "Excluded!"
        end
    end)
    
    createButton("Block", "Block remote", function()
        if selected then
            blocklist[selected.Remote] = true
            TextLabel.Text = "Blocked!"
        end
    end)
    
    createButton("Decode ByteNet", "Decode ByteNet packet", decodeByteNet)
end

-- [[ MAIN INITIALIZATION ]] --
local function init()
    xpcall(function()
        if not RunService:IsClient() then
            error("SimpleSpy cannot run on the server!")
        end
        
        -- Create UI
        createUI()
        
        -- Setup hooks
        setupHooks()
        
        -- Setup buttons
        setupButtons()
        
        -- Setup drag functionality
        local function onTopBarInput(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                local dragConnection
                local startPos = UserInputService:GetMouseLocation()
                local bgPos = Background.AbsolutePosition
                local offset = bgPos - startPos
                
                dragConnection = RunService.RenderStepped:Connect(function()
                    local newPos = UserInputService:GetMouseLocation()
                    Background.Position = UDim2.new(0, (offset + newPos).X, 0, (offset + newPos).Y)
                end)
                
                UserInputService.InputEnded:Connect(function(inputE)
                    if input == inputE and dragConnection then
                        dragConnection:Disconnect()
                    end
                end)
            end
        end
        
        TopBar.InputBegan:Connect(onTopBarInput)
        
        -- Toggle spy on click
        Simple.MouseButton1Click:Connect(function()
            if isHooked then
                disableHooks()
                Simple.TextColor3 = Color3.fromRGB(255, 0, 0)
            else
                setupHooks()
                Simple.TextColor3 = Color3.fromRGB(0, 255, 0)
            end
        end)
        
        -- Shutdown on close
        CloseButton.MouseButton1Click:Connect(function()
            disableHooks()
            SimpleSpy3:Destroy()
            getgenv().SimpleSpyExecuted = false
        end)
        
        getgenv().SimpleSpyExecuted = true
        Simple.TextColor3 = Color3.fromRGB(0, 255, 0)
        TextLabel.Text = "SimpleSpy Ready!"
        
    end, function(err)
        warn("SimpleSpy initialization error:", err)
        if SimpleSpy3 then SimpleSpy3:Destroy() end
    end)
end

-- Start the spy
init()
