local hookfunction = hookfunction or function(f, g) return g end
local newcclosure = newcclosure or function(f) return f end
local clonefunction = clonefunction or function(f) return f end
local cloneref = cloneref or function(i) return i end
local makewritable = makewritable or function(t) setreadonly(t, false) end
local makereadonly = makereadonly or function(t) setreadonly(t, true) end
local getrawmetatable = getrawmetatable or function(t) return nil end
local hookmetamethod = hookmetamethod or function(obj, mm, func) 
    local mt = getrawmetatable(obj)
    if mt then
        local old = mt[mm]
        makewritable(mt)
        mt[mm] = func
        makereadonly(mt)
        return old
    end
end

