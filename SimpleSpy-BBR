                end
            end)
        else
            codebox:setRaw(selected.GenScript)
        end
    end
end

-- [[ SCRIPT GENERATION ]] --
local function generateScript(logEntry)
    local remote = logEntry.Remote
    local args = logEntry.Args or {}
    
    if #args == 0 then
        return "-- No arguments\n" .. getRemotePath(remote) .. (remote:IsA("RemoteEvent") and ":FireServer()" or ":InvokeServer()")
    end
    
    local serialized = serializeTable(args, 0)
    local remotePath = getRemotePath(remote)
    local method = remote:IsA("RemoteEvent") and "FireServer" or "InvokeServer"
    
    return "local args = " .. serialized .. "\n\n" .. remotePath .. ":" .. method .. "(unpack(args))"
end

local function getRemotePath(remote)
    local path = {}
    local current = remote
    
    while current and current ~= game do
        table_insert(path, 1, current.Name)
        current = current.Parent
    end
    
    return "game." .. table.concat(path, ".")
end

-- [[ HOOK FUNCTIONS ]] --
local originalNamecall, originalEvent, originalUnreliableEvent, originalFunction
local isHooked = false

local function createHookHandler()
    return newcclosure(function(...)
        local method = getnamecallmethod()
        if not method then 
            if originalNamecall then return originalNamecall(...) end
            return
        end
        
        local remote = _select(1, ...)
        if _typeof(remote) ~= "Instance" then 
            if originalNamecall then return originalNamecall(...) end
            return
        end
        
        local lowerMethod = string.lower(method)
        if lowerMethod ~= "fireserver" and lowerMethod ~= "invokeserver" then
            if originalNamecall then return originalNamecall(...) end
            return
        end
        
        if not configs.logcheckcaller and checkcaller() then
            if originalNamecall then return originalNamecall(...) end
            return
        end
        
        local class, id = getRemoteInfo(remote)
        if blacklist[id] or blacklist[remote.Name] then
            if originalNamecall then return originalNamecall(...) end
            return
        end
        
        local argCount = _select("#", ...) - 1
        local args = {}
        for i = 1, argCount do
            args[i] = _select(i + 1, ...)
        end
        
        local logArgs = shallowClone(args)
        
        local data = {
            remote = remote,
            type = class,
            args = logArgs,
            method = method,
            callingscript = configs.funcEnabled and getcallingscript() or nil,
            infofunc = configs.funcEnabled and debug.info(2, "f") or nil,
            blocked = blocklist[id] or blocklist[remote.Name]
        }
        
        if not blocklist[id] and not blocklist[remote.Name] then
            queueRemoteLog(data)
        end
        
        if blocklist[id] or blocklist[remote.Name] then
            return
        end
        
        if originalNamecall then return originalNamecall(...) end
    end)
end

local function setupHooks()
    if isHooked then return end
    
    local mt = getrawmetatable(game)
    if mt and mt.__namecall then
        originalNamecall = mt.__namecall
        hookmetamethod(game, "__namecall", createHookHandler())
    end
    
    local remoteEvent = Instance_new("RemoteEvent")
    local remoteFunction = Instance_new("RemoteFunction")
    local unreliableRemote = Instance_new("UnreliableRemoteEvent")
    
    originalEvent = remoteEvent.FireServer
    originalFunction = remoteFunction.InvokeServer
    originalUnreliableEvent = unreliableRemote.FireServer
    
    hookfunction(remoteEvent.FireServer, newcclosure(function(self, ...)
        if not configs.logcheckcaller and checkcaller() then
            return originalEvent(self, ...)
        end
        
        local class, id = getRemoteInfo(self)
        if blacklist[id] or blacklist[self.Name] then
            return originalEvent(self, ...)
        end
        
        local args = {...}
        local logArgs = shallowClone(args)
        
        local data = {
            remote = self,
            type = class,
            args = logArgs,
            method = "FireServer",
            callingscript = configs.funcEnabled and getcallingscript() or nil,
            infofunc = configs.funcEnabled and debug.info(2, "f") or nil,
            blocked = blocklist[id] or blocklist[self.Name]
        }
        
        if not blocklist[id] and not blocklist[self.Name] then
            queueRemoteLog(data)
        end
        
        if blocklist[id] or blocklist[self.Name] then
            return
        end
        
        return originalEvent(self, ...)
    end))
    
    hookfunction(remoteFunction.InvokeServer, newcclosure(function(self, ...)
        if not configs.logcheckcaller and checkcaller() then
            return originalFunction(self, ...)
        end
        
        local class, id = getRemoteInfo(self)
        if blacklist[id] or blacklist[self.Name] then
            return originalFunction(self, ...)
        end
        
        local args = {...}
        local logArgs = shallowClone(args)
        
        local data = {
            remote = self,
            type = class,
            args = logArgs,
            method = "InvokeServer",
            callingscript = configs.funcEnabled and getcallingscript() or nil,
            infofunc = configs.funcEnabled and debug.info(2, "f") or nil,
            blocked = blocklist[id] or blocklist[self.Name]
        }
        
        if not blocklist[id] and not blocklist[self.Name] then
            queueRemoteLog(data)
        end
        
        if blocklist[id] or blocklist[self.Name] then
            return
        end
        
        return originalFunction(self, ...)
    end))
    
    hookfunction(unreliableRemote.FireServer, newcclosure(function(self, ...)
        if not configs.logcheckcaller and checkcaller() then
            return originalUnreliableEvent(self, ...)
        end
        
        local class, id = getRemoteInfo(self)
        if blacklist[id] or blacklist[self.Name] then
            return originalUnreliableEvent(self, ...)
        end
        
        local args = {...}
        local logArgs = shallowClone(args)
        
        local data = {
            remote = self,
            type = "unreliable",
            args = logArgs,
            method = "FireServer",
            callingscript = configs.funcEnabled and getcallingscript() or nil,
            infofunc = configs.funcEnabled and debug.info(2, "f") or nil,
            blocked = blocklist[id] or blocklist[self.Name]
        }
        
        if not blocklist[id] and not blocklist[self.Name] then
            queueRemoteLog(data)
        end
        
        if blocklist[id] or blocklist[self.Name] then
            return
        end
        
        return originalUnreliableEvent(self, ...)
    end))
    
    isHooked = true
end

local function disableHooks()
    if not isHooked then return end
    
    if originalNamecall then
        local mt = getrawmetatable(game)
        if mt then
            hookmetamethod(game, "__namecall", originalNamecall)
        end
    end
    
    if originalEvent then
        hookfunction(Instance_new("RemoteEvent").FireServer, originalEvent)
    end
    
    if originalFunction then
        hookfunction(Instance_new("RemoteFunction").InvokeServer, originalFunction)
    end
    
    if originalUnreliableEvent then
        hookfunction(Instance_new("UnreliableRemoteEvent").FireServer, originalUnreliableEvent)
    end
    
    isHooked = false
end

